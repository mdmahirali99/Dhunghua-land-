{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donghualand",
  "compatibility_date": "2024-01-01",
  "pages_build_output_dir": "./dist",
 "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database - donghualand-production
  // To create: npx wrangler d1 create donghualand-production
  // Then update database_id below with the returned ID
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donghualand-production",
      "database_id": "e50fbbb5-e107-40b8-adba-2b47634a7c54"
    }
  ]

  // Secrets (set via `wrangler pages secret put <NAME> --project-name donghualand`):
  // - TMDB_API_KEY        : Your TMDB API v3 key from themoviedb.org
  // - JWT_SECRET          : Random strong secret for JWT signing (e.g. openssl rand -hex 32)
  // - CLOUDINARY_CLOUD_NAME  : Your Cloudinary cloud name
  // - CLOUDINARY_API_KEY     : Your Cloudinary API Key
  // - CLOUDINARY_API_SECRET  : Your Cloudinary API Secret
}
